{
  "$schema": "https://schema.wrangler.com/config.json",
  "name": "tcstatus",
  "main": "./worker.js",
  "compatibility_date": "2026-10-25",
  "d1_databases": [
    {
      "binding": "TC",
      "database_name": "tc",
      "database_id": "fd0e9d90-b443-4002-8378-f0d817fb415b"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
